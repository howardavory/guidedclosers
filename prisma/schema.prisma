datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  role               String    // Enforced in app logic: 'ADMIN', 'MANAGER', 'CLOSER', 'SETTER'
  firstName          String?
  lastName           String?
  twoFactorSecret    String?
  isTwoFactorEnabled Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Invitation {
  id        String   @id @default(uuid())
  email     String   @unique
  role      String   // 'ADMIN', 'MANAGER', 'CLOSER', 'SETTER'
  token     String   @unique // Cryptographic hash
  expiresAt DateTime
  createdAt DateTime @default(now())
  isUsed    Boolean  @default(false)
}
